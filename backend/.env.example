PORT=5000

# OPTIONAL. Leave this blank/commented to auto-start a built-in in-memory MongoDB
# (zero setup - great for a quick demo, but data resets when the server stops).
# Set it to a real MongoDB (local install or free MongoDB Atlas cluster) for persistent storage.
# MONGO_URI=mongodb://127.0.0.1:27017/krishiqueue

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# --- Real bank payouts (RazorpayX) ---
# Leave all three blank to run in DEMO mode (payments are recorded but no real money moves).
# Fill these in ONLY if you have a KYC-verified RazorpayX business account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=

# --- Real SMS OTP (Twilio) ---
# Leave all three blank to run in DEMO mode (OTP is returned in the API response instead of texted).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
